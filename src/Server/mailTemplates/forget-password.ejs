<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <style>
        * {
            margin: 0;
            padding: 0;
        }
    </style>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
</head>

<body class="">
    <center style="background-color: #f4f4f4; height:100vh;margin-bottom: 0;display: block;">
        <div style="max-width: 750px; margin: 0 auto;font-family: popper,Arial,sans-serif;">

            <table style="width: 520px;" align="center" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <center style="margin-top: 0;padding-top:30px">
                            <span style="color:#022640;font-size: 20px;margin-right: 10px;font-weight: 500;">Welcome
                                to</span>
                            <img style="width: 150px;" alt="Img" align="center"
                                src="data:image/svg+xml;base64,">
                        </center>
                    </td>
                </tr>
                <tr>
                    <td align="center"
                        style="background-color: white;padding: 15px;margin-top: 25px;display: block;border-radius: 5px;margin-bottom: 40px;">
                        <img
                            src="data:image/png;base64,">
                        <p style="font-size:20px;margin-top:20px;color: #022640;font-weight: bold;">Hi
                        </p>

                        <p style="font-size: 15px;margin-bottom: 15px;color:#022640;margin-top:20px;line-height: 25px;">
                            Seems like you forgot your password. That's okay, it happens ! Please use the below Password
                            to reset your password.
                        </p>
                        <!-- <p> -->
                        <h2
                            style="margin-top: 20px;margin-bottom:20px;box-shadow: 0px 12px 24px #147cc766;background: #5f4788;color: #fff;border-radius: 5px;width: 140px;font-weight: 400;padding: 8px 10px;">
                            <%= pswd %>

                        </h2>
                        <p>Note:-Password will be expire in 15 days please don't share with anyone</p>
                    </td>
                </tr>
            </table>
        </div>
    </center>
</body>

</html>